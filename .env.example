# Public project URL used by Next.js image configuration and server calls.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REFERENCE.supabase.co

# Server-only Supabase key. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Generate at least 32 random characters. Rotating it invalidates existing sessions.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# One-time bootstrap credentials. Required only while admin_profiles.password_hash is NULL.
# Use a unique username and a password of at least 12 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Vercel Cron authentication. Generate a strong random value.
CRON_SECRET=
ACTIVITY_RETENTION_DAYS=180
